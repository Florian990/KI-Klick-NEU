modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true
integrations = ["resend:1.0.0"]
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd AI-Profit-Funnel && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
ADMIN_USERNAME = "Admin"
ADMIN_PASSWORD = "Erfolg2026!"
ADMIN_TEST_TOKEN = "4a2e524aba36ca315f8131cc30a3e98acf35"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd AI-Profit-Funnel && npm run start"]
build = ["bash", "-c", "cd AI-Profit-Funnel && npm run build"]
